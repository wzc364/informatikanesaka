rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Bootstrapped Admin: User email from runtime
      return isEmailVerified() && (
        request.auth.token.email == 'ega.nugraha141@guru.smp.belajar.id' || 
        request.auth.token.email == 'egawzc@gmail.com'
      );
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // App Settings - PUBLIC READ
    match /app_settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Material Configs - PUBLIC READ
    match /material_configs/{courseId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Students collection - PUBLIC READ (for login query)
    match /students/{studentId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Announcements - PUBLIC READ
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Assessments
    match /assessments/{assessmentId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn(); 
      allow update, delete: if isAdmin();
    }
    
    // Active Sessions
    match /active_sessions/{sessionId} {
      allow read, list, write: if isSignedIn();
    }

    // Access Logs
    match /access_logs/{logId} {
      allow create: if isSignedIn();
      allow read, list: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, list, delete: if isAdmin();
    }

    // Default deny (Moved to bottom)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
