rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn();
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // App Settings
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Material Configs
    match /material_configs/{courseId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Assessments
    match /assessments/{assessmentId} {
      allow create, update, read, list, delete: if isSignedIn();
    }
    
    // Active Sessions
    match /active_sessions/{sessionId} {
      allow create, update, delete, read, list: if isSignedIn();
    }

    // Access Logs
    match /access_logs/{logId} {
      allow create, read, list: if isSignedIn();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow create, update, delete, read, list: if isSignedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow create, read, list, delete: if isSignedIn();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
