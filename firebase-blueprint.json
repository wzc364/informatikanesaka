{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Represents a student enrolled in the school.",
      "type": "object",
      "properties": {
        "nis": { "type": "string", "description": "National Student ID" },
        "nama": { "type": "string", "description": "Full name" },
        "jenisKelamin": { "type": "string", "description": "L/P" },
        "kelas": { "type": "string", "description": "Class identifier" },
        "tahunPelajaran": { "type": "string", "description": "Academic year of enrollment (e.g. 2025/2026)" }
      },
      "required": ["nis", "nama", "jenisKelamin", "kelas"]
    },
    "MaterialConfig": {
      "title": "Material Config",
      "description": "Configuration for a material/course.",
      "type": "object",
      "properties": {
        "isActive": { "type": "boolean", "description": "Whether the material is visible to students" },
        "isGatekeepingEnabled": { "type": "boolean", "description": "Whether students are forced to take quiz to pass to next topic" },
        "topicTimers": {
          "type": "object",
          "description": "Timer config per topic (in seconds). Key is topic ID, value is seconds.",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "Assessment": {
      "title": "Assessment",
      "description": "The result of a student completing a material.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "description": "Reference to student" },
        "courseId": { "type": "string", "description": "Reference to course" },
        "courseTitle": { "type": "string", "description": "Title of the course" },
        "score": { "type": "number", "description": "Final score" },
        "wrongAnswers": { "type": "number", "description": "Number of mistakes" },
        "tahunPelajaran": { "type": "string", "description": "Academic year" },
        "semester": { "type": "string", "enum": ["Ganjil", "Genap"], "description": "Semester" },
        "completedAt": { "type": "string", "format": "date-time", "description": "Completion timestamp" }
      },
      "required": ["studentId", "courseId", "score", "completedAt"]
    },
    "AccessLog": {
      "title": "Access Log",
      "description": "Logs every time a student logs in.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "description": "Reference to student" },
        "studentName": { "type": "string", "description": "Name of the student" },
        "ip": { "type": "string", "description": "Client IP address" },
        "device": { "type": "string", "description": "User agent / device info" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Login time" }
      },
      "required": ["studentId", "studentName", "ip", "device", "timestamp"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Announcement from admin to students.",
      "type": "object",
      "properties": {
        "targetType": { "type": "string", "enum": ["all", "class", "student"], "description": "Who can see this" },
        "targetValue": { "type": "string", "description": "Class ID or Student ID (empty if all)" },
        "content": { "type": "string", "description": "Message text" },
        "link": { "type": "string", "description": "Optional clickable link" },
        "senderId": { "type": "string", "description": "ID of sender (admin)" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Sent time" }
      },
      "required": ["targetType", "content", "senderId", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notification for admins about student activities.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["course_completion"], "description": "Type of event" },
        "studentId": { "type": "string", "description": "ID of the student" },
        "studentName": { "type": "string", "description": "Name of the student" },
        "courseId": { "type": "string", "description": "ID of the course" },
        "courseTitle": { "type": "string", "description": "Title of the course" },
        "score": { "type": "number", "description": "Score achieved" },
        "isRead": { "type": "boolean", "description": "Whether admin has read the notification" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the event occurred" }
      },
      "required": ["type", "studentId", "studentName", "courseId", "courseTitle", "score", "timestamp"]
    },
    "AppSetting": {
      "title": "App Setting",
      "description": "Global settings for the application.",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string", "description": "URL of the school logo" },
        "backgroundPreset": { "type": "string", "description": "Selected application background preset ID" },
        "activeTahunPelajaran": { "type": "string", "description": "Active academic year (e.g. 2025/2026)" },
        "activeSemester": { "type": "string", "enum": ["Ganjil", "Genap"], "description": "Active semester" },
        "tahunPelajaranList": { "type": "array", "description": "List of configured academic years" },
        "jadwalSettings": { "type": "object", "description": "Lesson & break duration and per-day timetable configuration" }
      }
    },
    "ActiveSession": {
      "title": "Active Session",
      "description": "Represents a student's active learning session.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "status": { "type": "string", "enum": ["working", "finished"] },
        "currentScore": { "type": "number" },
        "kelas": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" },
        "cheatingAttempts": { "type": "number" },
        "cheatingDetails": { "type": "array", "items": { "type": "string" } }
      }
    },
    "OnlineUser": {
      "title": "Online User",
      "description": "Tracks currently logged-in students and supports remote admin force-logout.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "nis": { "type": "string" },
        "studentName": { "type": "string" },
        "kelas": { "type": "string" },
        "tahunPelajaran": { "type": "string" },
        "currentPage": { "type": "string" },
        "currentActivity": { "type": "string" },
        "sessionToken": { "type": "string" },
        "forceLogout": { "type": "boolean" },
        "forceDashboardNonce": { "type": "number" },
        "loginAt": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "forceLogout"]
    },
    "SoalSet": {
      "title": "Soal Set",
      "description": "Kartu paket soal pilihan ganda 4 opsi berdasarkan judul.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "kelas": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isFullScreen": { "type": "boolean" },
        "isScoreVisible": { "type": "boolean" },
        "timerMode": { "type": "string", "enum": ["per_judul", "per_soal"] },
        "titleTimerSeconds": { "type": "number" },
        "defaultQuestionTimerSeconds": { "type": "number" },
        "shuffleQuestions": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "isActive", "timerMode"]
    },
    "SoalQuestion": {
      "title": "Soal Question",
      "description": "Butir soal PG 4 opsi dengan dukungan gambar soal/opsi dan timer per soal.",
      "type": "object",
      "properties": {
        "setId": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "questionText": { "type": "string" },
        "questionImage": { "type": "string" },
        "options": { "type": "array" },
        "correctAnswer": { "type": "number" },
        "timerSeconds": { "type": "number" },
        "explanation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["setId", "isActive", "options", "correctAnswer"]
    },
    "KombatMatch": {
      "title": "Kombat Match",
      "description": "Real-time multiplayer matchmaking room and combat sync state for Informatika Kombat.",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string", "maxLength": 12 },
        "isPublic": { "type": "boolean" },
        "status": { "type": "string", "enum": ["waiting", "active", "finished", "abandoned"] },
        "stage": { "type": "number" },
        "round": { "type": "number" },
        "p1Uid": { "type": "string", "maxLength": 128 },
        "p1Name": { "type": "string", "maxLength": 80 },
        "p1Fighter": { "type": "string", "maxLength": 32 },
        "p1Wins": { "type": "number" },
        "p2Uid": { "type": "string", "maxLength": 128 },
        "p2Name": { "type": "string", "maxLength": 80 },
        "p2Fighter": { "type": "string", "maxLength": 32 },
        "p2Wins": { "type": "number" },
        "winnerSide": { "type": "string", "enum": ["p1", "p2", "draw"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomCode", "isPublic", "status", "p1Uid", "p1Name", "p1Fighter"]
    },
    "ScopedMaterialConfig": {
      "title": "Scoped Material Config",
      "description": "Per-academic-year and per-semester configuration for a material/course.",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "tahunPelajaran": { "type": "string" },
        "semester": { "type": "string", "enum": ["Ganjil", "Genap"] },
        "isActive": { "type": "boolean" },
        "isGatekeepingEnabled": { "type": "boolean" },
        "isFullScreen": { "type": "boolean" },
        "isScoreVisible": { "type": "boolean" }
      },
      "required": ["courseId", "tahunPelajaran", "semester", "isActive"]
    },
    "JadwalPelajaran": {
      "title": "Jadwal Pelajaran",
      "description": "Class timetable entries scoped by academic year and semester.",
      "type": "object",
      "properties": {
        "tahunPelajaran": { "type": "string" },
        "semester": { "type": "string", "enum": ["Ganjil", "Genap"] },
        "kelas": { "type": "string" },
        "hari": { "type": "string" },
        "jamKe": { "type": "string" },
        "waktuMulai": { "type": "string" },
        "waktuSelesai": { "type": "string" },
        "mataPelajaran": { "type": "string" },
        "isBreak": { "type": "boolean" }
      },
      "required": ["tahunPelajaran", "semester", "kelas", "hari", "mataPelajaran"]
    },
    "TujuanPembelajaran": {
      "title": "Tujuan Pembelajaran",
      "description": "Learning objectives scoped per academic year (persists across semesters).",
      "type": "object",
      "properties": {
        "tahunPelajaran": { "type": "string" },
        "kodeTp": { "type": "string" },
        "kelas": { "type": "string" },
        "elemen": { "type": "string" },
        "materiId": { "type": "string" },
        "deskripsi": { "type": "string" },
        "indikator": { "type": "string" },
        "kkm": { "type": "number" }
      },
      "required": ["tahunPelajaran", "kodeTp", "deskripsi"]
    },
    "AgendaHarian": {
      "title": "Agenda Harian",
      "description": "Daily teaching agenda scoped by academic year and semester.",
      "type": "object",
      "properties": {
        "tahunPelajaran": { "type": "string" },
        "semester": { "type": "string", "enum": ["Ganjil", "Genap"] },
        "tanggal": { "type": "string" },
        "kelas": { "type": "string" },
        "pertemuanKe": { "type": "string" },
        "jadwalId": { "type": "string" },
        "hari": { "type": "string" },
        "jamKe": { "type": "string" },
        "waktuMulai": { "type": "string" },
        "waktuSelesai": { "type": "string" },
        "mataPelajaran": { "type": "string" },
        "jenisKegiatan": { "type": "string" },
        "attendanceMode": { "type": "string", "enum": ["manual", "all_present", "no_attendance"] },
        "tpId": { "type": "string" },
        "tpKode": { "type": "string" },
        "materi": { "type": "string" },
        "kegiatan": { "type": "string" },
        "hadirCount": { "type": "number" },
        "sakitCount": { "type": "number" },
        "izinCount": { "type": "number" },
        "alpaCount": { "type": "number" }
      },
      "required": ["tahunPelajaran", "semester", "tanggal", "kelas", "materi"]
    },
    "AbsensiSiswa": {
      "title": "Absensi Siswa",
      "description": "Daily student attendance records per class, year, and semester.",
      "type": "object",
      "properties": {
        "tahunPelajaran": { "type": "string" },
        "semester": { "type": "string", "enum": ["Ganjil", "Genap"] },
        "tanggal": { "type": "string" },
        "kelas": { "type": "string" },
        "agendaId": { "type": "string" },
        "pertemuanKe": { "type": "string" },
        "jamKe": { "type": "string" },
        "materi": { "type": "string" },
        "entries": { "type": "object" }
      },
      "required": ["tahunPelajaran", "semester", "tanggal", "kelas", "entries"]
    },
    "NilaiSumatif": {
      "title": "Nilai Sumatif",
      "description": "Summative exam scores per class, TP, year, and semester.",
      "type": "object",
      "properties": {
        "tahunPelajaran": { "type": "string" },
        "semester": { "type": "string", "enum": ["Ganjil", "Genap"] },
        "kelas": { "type": "string" },
        "judul": { "type": "string" },
        "jenis": { "type": "string" },
        "tanggal": { "type": "string" },
        "tpId": { "type": "string" },
        "tpKode": { "type": "string" },
        "bobot": { "type": "number" },
        "scores": { "type": "object" }
      },
      "required": ["tahunPelajaran", "semester", "kelas", "judul"]
    },
    "NilaiAsesmenHarian": {
      "title": "Nilai Asesmen Harian",
      "description": "Daily assessment scores linked to KBM dan Asesmen Harian agenda entries.",
      "type": "object",
      "properties": {
        "agendaId": { "type": "string" },
        "tahunPelajaran": { "type": "string" },
        "semester": { "type": "string", "enum": ["Ganjil", "Genap"] },
        "kelas": { "type": "string" },
        "tanggal": { "type": "string" },
        "materi": { "type": "string" },
        "tpId": { "type": "string" },
        "tpKode": { "type": "string" },
        "scores": { "type": "object" },
        "notes": { "type": "object" }
      },
      "required": ["agendaId", "tahunPelajaran", "semester", "kelas", "tanggal", "materi"]
    },
    "NilaiRapor": {
      "title": "Nilai Rapor",
      "description": "Student report card grades per student, year, and semester.",
      "type": "object",
      "properties": {
        "tahunPelajaran": { "type": "string" },
        "semester": { "type": "string", "enum": ["Ganjil", "Genap"] },
        "studentId": { "type": "string" },
        "studentNis": { "type": "string" },
        "studentName": { "type": "string" },
        "kelas": { "type": "string" },
        "nilaiFormatif": { "type": "number" },
        "nilaiSumatif": { "type": "number" },
        "nilaiProyek": { "type": "number" },
        "nilaiAkhir": { "type": "number" },
        "predikat": { "type": "string" },
        "capaianKompetensi": { "type": "string" },
        "isFinalized": { "type": "boolean" }
      },
      "required": ["tahunPelajaran", "semester", "studentId", "nilaiAkhir"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of students."
    },
    "/material_configs/{courseId}": {
      "schema": "MaterialConfig",
      "description": "Legacy configuration for courses."
    },
    "/scoped_material_configs/{scopedConfigId}": {
      "schema": "ScopedMaterialConfig",
      "description": "Academic-year and semester scoped course configurations."
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Student assessment results."
    },
    "/access_logs/{logId}": {
      "schema": "AccessLog",
      "description": "History of student logins."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Announcements from teacher/admin to students."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notifications for admin users."
    },
    "/app_settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Global application settings."
    },
    "/active_sessions/{sessionId}": {
      "schema": "ActiveSession",
      "description": "Tracks currently active student sessions."
    },
    "/online_users/{studentId}": {
      "schema": "OnlineUser",
      "description": "Tracks logged-in students for admin monitoring and remote logout."
    },
    "/soal_sets/{setId}": {
      "schema": "SoalSet",
      "description": "Title-based question bank cards."
    },
    "/soal_questions/{questionId}": {
      "schema": "SoalQuestion",
      "description": "Multiple-choice 4-option questions belonging to a SoalSet."
    },
    "/kombat_matches/{matchId}": {
      "schema": "KombatMatch",
      "description": "Multiplayer matchmaking rooms and live duel state for Informatika Kombat."
    },
    "/jadwal_pelajaran/{jadwalId}": {
      "schema": "JadwalPelajaran",
      "description": "Class schedule entries scoped by year and semester."
    },
    "/tujuan_pembelajaran/{tpId}": {
      "schema": "TujuanPembelajaran",
      "description": "Learning objectives scoped by academic year."
    },
    "/agenda_harian/{agendaId}": {
      "schema": "AgendaHarian",
      "description": "Daily teaching journal entries."
    },
    "/absensi_siswa/{absensiId}": {
      "schema": "AbsensiSiswa",
      "description": "Daily student attendance records."
    },
    "/nilai_sumatif/{sumatifId}": {
      "schema": "NilaiSumatif",
      "description": "Summative exam scores per class."
    },
    "/nilai_asesmen_harian/{asesmenId}": {
      "schema": "NilaiAsesmenHarian",
      "description": "Daily assessment scores linked to agenda KBM dan Asesmen Harian."
    },
    "/nilai_rapor/{raporId}": {
      "schema": "NilaiRapor",
      "description": "Report card grades per student."
    }
  }
}
