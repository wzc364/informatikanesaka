{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/analyze-question-doc.js": {
      "maxDuration": 60
    },
    "api/generate-questions.js": {
      "maxDuration": 60
    },
    "api/soal.js": {
      "maxDuration": 30
    },
    "api/students.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/soal",
      "destination": "/api/soal"
    },
    {
      "source": "/api/soal/:path*",
      "destination": "/api/soal?__soalPath=:path*"
    },
    {
      "source": "/api/students",
      "destination": "/api/students"
    },
    {
      "source": "/api/students/:path*",
      "destination": "/api/students?__studentsPath=:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|images/).*)",
      "destination": "/index.html"
    }
  ]
}
