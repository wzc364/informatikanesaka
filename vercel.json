{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/analyze-question-doc.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|images/).*)",
      "destination": "/index.html"
    }
  ]
}
